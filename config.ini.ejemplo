; Configuración del Sistema de Inscripciones CPU UNPRG.
; Copia este archivo como  config.ini  y ajústalo en cada computadora.

[app]
; servidor = esta PC guarda los datos y atiende a las demás
; cliente  = esta PC solo se conecta al servidor
modo = servidor

; Solo lo usan las PCs en modo cliente. Pon la IP de la PC servidor
; (el servidor la muestra al arrancar).
servidor_url = http://192.168.1.10:8000

puerto = 8000
ciclo = 2026-II

; si = la ficha PDF no se emite mientras el pago no este
;      verificado contra el reporte del Banco de la Nacion
exigir_pago = no
sede = Centro Preuniversitario Juan Francisco Aguinaga Castro

; Se genera sola la primera vez. No la copies entre computadoras
; ni la compartas: con ella se firman las sesiones.
clave_firma =

[mysql]
host = localhost
puerto = 3306
usuario = root
password =
base = cpu_unprg

[smtp]
host = smtp.gmail.com
port = 465
scheme = smtps
username =
password =
from_address =
from_name = Centro Preuniversitario UNPRG

[google_sheets]
activo = si
spreadsheet_id =
sheet_id =
ciclo = 2026-II
intervalo_segundos = 300
; JSON de una cuenta de servicio con acceso de lector SOLO a la hoja de respuestas.
credenciales = credenciales/google-sheets.json
